{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kubohiroya/turbowarp-scene-graph/main/schemas/editor-compatible-scene-document.schema.json",
  "title": "TurboWarp Scene Graph Document (existing parser compatibility)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "root"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layer": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        }
      }
    },
    "root": {
      "$ref": "editor-compatible-scene-node.schema.json"
    }
  }
}
