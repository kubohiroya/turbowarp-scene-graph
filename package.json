{
  "name": "@kubohiroya/turbowarp-scene-graph",
  "version": "0.2.0",
  "description": "Scene graph planning primitives for TurboWarp 3D extensions: YAML documents, validation, normalization, and deterministic call plans.",
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "license": "MPL-2.0",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://github.com/kubohiroya/turbowarp-scene-graph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-scene-graph.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-scene-graph/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "schemas/",
    "src/",
    "README.md",
    "README.ja.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --project tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "pack:check": "pnpm pack --dry-run",
    "release:check": "npm publish --dry-run --access public",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run pack:check"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "ajv": "^8.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "turbowarp",
    "scene-graph",
    "aframe",
    "ar",
    "3d",
    "yaml"
  ],
  "dependencies": {
    "@kubohiroya/turbowarp-ar": "^0.3.0",
    "yaml": "^2.9.0"
  }
}
